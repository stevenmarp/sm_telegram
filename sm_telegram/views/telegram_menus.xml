<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_telegram_root" name="Telegram" sequence="80"
              web_icon="sm_telegram,static/description/icon.png"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_telegram_config" name="Configuration"
              parent="menu_telegram_root" sequence="50"/>

    <menuitem id="menu_telegram_bots" name="Bots"
              parent="menu_telegram_config"
              action="action_telegram_bot"
              sequence="10"/>

    <menuitem id="menu_telegram_model_config" name="Model Configs"
              parent="menu_telegram_config"
              action="action_telegram_model_config"
              sequence="20"/>

    <menuitem id="menu_telegram_templates" name="Message Templates"
              parent="menu_telegram_config"
              action="action_telegram_template"
              sequence="30"/>

    <!-- Main menu items -->
    <menuitem id="menu_telegram_message_log" name="Message Logs"
              parent="menu_telegram_root"
              action="action_telegram_message_log"
              sequence="20"/>

</odoo>

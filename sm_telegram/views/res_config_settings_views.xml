<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_telegram" model="ir.ui.view">
        <field name="name">res.config.settings.view.sm.telegram</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Telegram" name="sm_telegram">
                    <block title="Bot Configuration" name="telegram_bot_config">
                        <setting string="Default Bot" help="Select the default Telegram bot for sending messages">
                            <field name="telegram_default_bot_id"/>
                        </setting>
                    </block>
                    <block title="Auto-Retry" name="telegram_retry_config">
                        <setting string="Retry Failed Messages" help="Automatically retry failed messages via scheduled action">
                            <field name="telegram_retry_enabled"/>
                        </setting>
                        <setting string="Max Retries" help="Maximum number of retry attempts for failed messages">
                            <field name="telegram_max_retries"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>

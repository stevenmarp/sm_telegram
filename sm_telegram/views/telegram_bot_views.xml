<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bot Form View -->
    <record id="view_telegram_bot_form" model="ir.ui.view">
        <field name="name">sm.telegram.bot.form</field>
        <field name="model">sm.telegram.bot</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot">
                <header>
                    <button name="action_verify_bot"
                            type="object"
                            string="Verify Bot"
                            class="btn-primary"
                            invisible="state == 'verified'"/>
                    <button name="action_setup_webhook"
                            type="object"
                            string="Setup Webhook"
                            class="btn-primary"
                            invisible="state != 'verified'"/>
                    <button name="action_remove_webhook"
                            type="object"
                            string="Remove Webhook"
                            class="btn-secondary"
                            invisible="state != 'verified'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Bot Name"/></h1>
                    </div>
                    <group>
                        <group string="Bot Configuration">
                            <field name="token" password="True"/>
                            <field name="bot_username" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Webhook">
                            <field name="webhook_secret"/>
                            <field name="webhook_url" widget="url" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Bot List View -->
    <record id="view_telegram_bot_list" model="ir.ui.view">
        <field name="name">sm.telegram.bot.list</field>
        <field name="model">sm.telegram.bot</field>
        <field name="arch" type="xml">
            <list string="Telegram Bots" decoration-success="state == 'verified'"
                  decoration-danger="state == 'error'" decoration-muted="state == 'draft'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bot_username"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'verified'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'draft'"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Bot Action -->
    <record id="action_telegram_bot" model="ir.actions.act_window">
        <field name="name">Telegram Bots</field>
        <field name="res_model">sm.telegram.bot</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
